<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/banner_recording_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="?attr/colorErrorContainer"
    android:paddingHorizontal="12dp"
    android:visibility="gone">

    <View
        android:id="@+id/banner_recording_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/banner_recording_dot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/banner_recording_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="?attr/colorOnErrorContainer"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:singleLine="true"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/banner_recording_dot"
        app:layout_constraintEnd_toStartOf="@id/banner_recording_timer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Recording for Alice"/>

    <Chronometer
        android:id="@+id/banner_recording_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnErrorContainer"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:layout_constraintEnd_toStartOf="@id/banner_recording_cancel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="12dp"/>

    <ImageButton
        android:id="@+id/banner_recording_cancel"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/action_cancel"
        app:tint="?attr/colorOnErrorContainer"
        app:layout_constraintEnd_toStartOf="@id/banner_recording_send"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageButton
        android:id="@+id/banner_recording_send"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_send"
        android:contentDescription="@string/action_send_now"
        app:tint="?attr/colorOnErrorContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
