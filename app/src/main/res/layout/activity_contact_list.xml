<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.VoiceDrop.Wordmark"/>

        <TextView
            android:id="@+id/banner_aead_soft_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorWarningContainer"
            android:textColor="?attr/colorOnWarningContainer"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"/>

        <include
            android:id="@+id/banner_recording"
            layout="@layout/banner_recording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_contacts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

    <include
        android:id="@+id/empty_state_contacts"
        layout="@layout/empty_state_contacts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="end"
        android:clipChildren="false">

        <FrameLayout
            android:id="@+id/fab_record_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/slide_to_cancel_track"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="64dp"
                android:visibility="gone"
                android:alpha="0.3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/slide_to_cancel"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceLabelLarge"/>
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_record_fanout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/action_record"
                app:backgroundTint="?attr/colorPrimary"
                app:tint="?attr/colorOnPrimary"/>
        </FrameLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/add_contact"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:tint="?attr/colorOnSecondaryContainer"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/ic_input_add"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
